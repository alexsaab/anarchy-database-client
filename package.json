{
  "name": "vscode-database-client-clone",
  "displayName": "Anarchy Database Client",
  "description": "Полнофункциональный клиент баз данных для VS Code (клон cweijan.vscode-database-client2)",
  "version": "0.4.0",
  "publisher": "custom-developer",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexsaab/anarchy-database-client.git"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:database-client-explorer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "database-client",
          "title": "%viewsContainer.databaseClient%",
          "icon": "resources/database-a.svg"
        }
      ]
    },
    "views": {
      "database-client": [
        {
          "id": "database-client-explorer",
          "name": "%view.databaseExplorer%"
        }
      ]
    },
    "commands": [
      {
        "command": "dbClient.addConnection",
        "title": "%command.addConnection%",
        "icon": "$(add)"
      },
      {
        "command": "dbClient.editConnection",
        "title": "%command.editConnection%",
        "icon": "$(edit)"
      },
      {
        "command": "dbClient.refreshTree",
        "title": "%command.refreshTree%",
        "icon": "$(refresh)"
      },
      {
        "command": "dbClient.deleteConnection",
        "title": "%command.deleteConnection%",
        "icon": "$(trash)"
      },
      {
        "command": "dbClient.openTable",
        "title": "%command.openTable%",
        "icon": "$(table)"
      },
      {
        "command": "dbClient.designTable",
        "title": "%command.designTable%",
        "icon": "$(tools)"
      },
      {
        "command": "dbClient.queryConsole",
        "title": "%command.queryConsole%",
        "icon": "$(terminal)"
      },
      {
        "command": "dbClient.newQuery",
        "title": "%command.newQuery%",
        "icon": "$(new-file)"
      },
      {
        "command": "dbClient.dumpDatabase",
        "title": "%command.dumpDatabase%",
        "icon": "$(export)"
      },
      {
        "command": "dbClient.importSql",
        "title": "%command.importSql%",
        "icon": "$(import)"
      },
      {
        "command": "dbClient.openErd",
        "title": "%command.openErd%",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "dbClient.processList",
        "title": "%command.processList%",
        "icon": "$(pulse)"
      },
      {
        "command": "dbClient.generateMockData",
        "title": "%command.generateMockData%",
        "icon": "$(sparkle)"
      },
      {
        "command": "dbClient.createTable",
        "title": "%command.createTable%",
        "icon": "$(add)"
      },
      {
        "command": "dbClient.createView",
        "title": "%command.createView%",
        "icon": "$(add)"
      },
      {
        "command": "dbClient.createFunction",
        "title": "%command.createFunction%",
        "icon": "$(add)"
      },
      {
        "command": "dbClient.createProcedure",
        "title": "%command.createProcedure%",
        "icon": "$(add)"
      },
      {
        "command": "dbClient.createTrigger",
        "title": "%command.createTrigger%",
        "icon": "$(add)"
      },
      {
        "command": "dbClient.addQueryFile",
        "title": "%command.addQueryFile%",
        "icon": "$(add)"
      },
      {
        "command": "dbClient.bindQueryFolder",
        "title": "%command.bindQueryFolder%",
        "icon": "$(link)"
      },
      {
        "command": "dbClient.renameQueryFile",
        "title": "%command.renameQueryFile%",
        "icon": "$(edit)"
      },
      {
        "command": "dbClient.deleteQueryFile",
        "title": "%command.deleteQueryFile%",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbClient.addConnection",
          "when": "view == database-client-explorer",
          "group": "navigation@1"
        },
        {
          "command": "dbClient.refreshTree",
          "when": "view == database-client-explorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dbClient.bindQueryFolder",
          "when": "view == database-client-explorer && viewItem == queryGroupNode",
          "group": "inline@1"
        },
        {
          "command": "dbClient.addQueryFile",
          "when": "view == database-client-explorer && viewItem == queryGroupNode",
          "group": "inline@2"
        },
        {
          "command": "dbClient.renameQueryFile",
          "when": "view == database-client-explorer && viewItem == queryFileNode",
          "group": "1_edit@1"
        },
        {
          "command": "dbClient.deleteQueryFile",
          "when": "view == database-client-explorer && viewItem == queryFileNode",
          "group": "1_edit@2"
        },
        {
          "command": "dbClient.createTable",
          "when": "view == database-client-explorer && viewItem == tableGroupNode",
          "group": "inline"
        },
        {
          "command": "dbClient.createView",
          "when": "view == database-client-explorer && viewItem == viewGroupNode",
          "group": "inline"
        },
        {
          "command": "dbClient.createFunction",
          "when": "view == database-client-explorer && viewItem == functionGroupNode",
          "group": "inline"
        },
        {
          "command": "dbClient.createProcedure",
          "when": "view == database-client-explorer && viewItem == procedureGroupNode",
          "group": "inline"
        },
        {
          "command": "dbClient.createTrigger",
          "when": "view == database-client-explorer && viewItem == triggerGroupNode",
          "group": "inline"
        },
        {
          "command": "dbClient.openTable",
          "when": "view == database-client-explorer && viewItem == tableNode",
          "group": "inline@1"
        },
        {
          "command": "dbClient.designTable",
          "when": "view == database-client-explorer && viewItem == tableNode",
          "group": "inline@2"
        },
        {
          "command": "dbClient.generateMockData",
          "when": "view == database-client-explorer && viewItem == tableNode",
          "group": "1_table@1"
        },
        {
          "command": "dbClient.queryConsole",
          "when": "view == database-client-explorer && (viewItem == connectionNode || viewItem == databaseNode)",
          "group": "1_manage@1"
        },
        {
          "command": "dbClient.openErd",
          "when": "view == database-client-explorer && viewItem == databaseNode",
          "group": "1_manage@2"
        },
        {
          "command": "dbClient.dumpDatabase",
          "when": "view == database-client-explorer && (viewItem == connectionNode || viewItem == databaseNode)",
          "group": "2_dump@1"
        },
        {
          "command": "dbClient.importSql",
          "when": "view == database-client-explorer && (viewItem == connectionNode || viewItem == databaseNode)",
          "group": "2_dump@2"
        },
        {
          "command": "dbClient.processList",
          "when": "view == database-client-explorer && viewItem == connectionNode",
          "group": "3_server@1"
        },
        {
          "command": "dbClient.editConnection",
          "when": "view == database-client-explorer && viewItem == connectionNode",
          "group": "z_config@1"
        },
        {
          "command": "dbClient.deleteConnection",
          "when": "view == database-client-explorer && viewItem == connectionNode",
          "group": "z_config@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@clickhouse/client": "^1.11.0",
    "@elastic/elasticsearch": "^8.12.0",
    "elasticsearch": "^16.7.3",
    "ioredis": "^5.3.2",
    "mongodb": "^6.3.0",
    "mysql2": "^3.9.1",
    "pg": "^8.11.3",
    "redis": "^4.6.13",
    "sqlite3": "^5.1.7",
    "ssh2": "^1.15.0"
  }
}
